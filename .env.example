# Canonical origin (no trailing slash). Defaults to https://shanishingnapurtemple.com
NEXT_PUBLIC_SITE_URL=https://shanishingnapurtemple.com

# Analytics — leave blank to load no tracking scripts at all.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GTM_ID=

# Google Search Console HTML-tag verification token (content value only).
NEXT_PUBLIC_GSC_VERIFICATION=

# Google AdSense publisher ID (e.g. ca-pub-XXXXXXXXXXXXXXXX). Ad slots stay empty until set.
NEXT_PUBLIC_ADSENSE_CLIENT=

# Contact form delivery. The form POSTs to /api/contact, which forwards a JSON
# payload to this webhook (e.g. Formspree, Make, Zapier, a Slack/Discord hook).
# If unset, the API responds 503 and the form tells the visitor it is unavailable.
CONTACT_WEBHOOK_URL=
